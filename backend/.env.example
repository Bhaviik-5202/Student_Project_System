# ==========================================================
# Student Project System - Backend Environment Configuration
# ==========================================================
# Copy this file to `.env` and replace placeholder values.

# ==============================
# Application
# ==============================
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000/api/v1

# ==============================
# Database
# ==============================
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.yiyymsc.mongodb.net/student_project_system?appName=Cluster0
# Optional: Set custom DNS servers if Node.js fails to resolve MongoDB SRV records (e.g., DNS_SERVERS=8.8.8.8,1.1.1.1)
# DNS_SERVERS=


# ==============================
# Authentication (JWT)
# ==============================
JWT_SECRET=replace_with_strong_random_secret
JWT_EXPIRES_IN=1d

# ==============================
# Security
# ==============================
BCRYPT_SALT_ROUNDS=12
CORS_ORIGIN=http://localhost:5173

# ==============================
# File Upload
# ==============================
MAX_FILE_SIZE=5242880

# ==============================
# Single Super Admin Configuration
# ==============================
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change_this_super_admin_password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_super_admin_password
# ==============================
# Email (Optional - Leave blank if not used)
# ==============================
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
